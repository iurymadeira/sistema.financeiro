# Copie para .env e ajuste. O .env NUNCA vai para o Git.
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

# Banco (PostgreSQL). Estes valores também são usados pelo docker-compose.
DB_HOST=localhost
DB_PORT=5432
DB_USER=financeiro
DB_PASSWORD=troque-esta-senha
DB_NAME=financeiro_db

# Em hospedagem, use só a URL completa (ela tem prioridade sobre as variáveis acima):
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# DB_SSL=true

# Fuso usado para saber "que dia é hoje" (ex.: ao encerrar uma recorrência). Padrão: America/Sao_Paulo
# APP_TIMEZONE=America/Fortaleza

# --- Hospedagem (PR 4, ver docs/deploy.md) ---
# Senha de acesso provisória (ADR 0026). Vazia = sem portaria (só para desenvolvimento).
# Em NODE_ENV=production ela é obrigatória.
ACCESS_PASSWORD=
# Em hospedagem use 0.0.0.0 (o padrão 127.0.0.1 só atende a própria máquina)
# HOST=0.0.0.0
# NODE_ENV=production
# FRONTEND_ORIGIN aceita várias origens separadas por vírgula
