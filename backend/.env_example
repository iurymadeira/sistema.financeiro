# Copie para .env e ajuste. O .env NUNCA vai para o Git.
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

# Banco (PostgreSQL). Estes valores também são usados pelo docker-compose.
DB_HOST=localhost
DB_PORT=5432
DB_USER=financeiro
DB_PASSWORD=troque-esta-senha
DB_NAME=financeiro_db

# Em hospedagem, use só a URL completa (ela tem prioridade sobre as variáveis acima):
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# DB_SSL=true
